<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0 -->
<!-- Registers nova_theme's ThemeJob on onFirstVisibleTask, so the Nova palette
     is applied once the first window is about to show. Pattern follows
     extensions/source/update/check/registry/data/.../Office/Jobs.xcu. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="NovaTheme" oor:op="fuse">
      <prop oor:name="Service">
        <value>org.novaoffice.ThemeJob</value>
      </prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="onFirstVisibleTask" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="NovaTheme" oor:op="fuse"/>
      </node>
    </node>
  </node>
</oor:component-data>
