<?xml version="1.0" encoding="UTF-8"?>
<!--
 * SPDX-License-Identifier: MPL-2.0
 *
 * Nova-Office configuration schema. Additive: touches no upstream officecfg
 * node. Nova code reads/writes these via configmgr, like all LO settings.
 * Product name/vendor come from the configure step, not here.
 -->
<!DOCTYPE oor:component-schema SYSTEM "../../../component-schema.dtd">
<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" oor:name="Nova" oor:package="org.openoffice" xml:lang="en-US">
  <info>
    <desc>Nova-Office settings: appearance, workspace, sync, AI, telemetry.</desc>
  </info>
  <templates/>
  <component>
    <group oor:name="Appearance">
      <info>
        <desc>Theme and visual mode (see docs/design-system.md).</desc>
      </info>
      <prop oor:name="Theme" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>light | dark | system | hc</desc>
        </info>
        <value>system</value>
      </prop>
      <prop oor:name="ReducedMotion" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Collapse animations (also follows the OS setting).</desc>
        </info>
        <value>false</value>
      </prop>
      <prop oor:name="NovaUiMode" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Use the Nova shell instead of the classic LibreOffice UI. EXPERIMENTAL.</desc>
        </info>
        <value>false</value>
      </prop>
    </group>
    <group oor:name="Workspace">
      <info>
        <desc>Local workspace (see docs/architecture.md).</desc>
      </info>
      <prop oor:name="DefaultPath" oor:type="xs:string" oor:nillable="true">
        <info>
          <desc>Path of the active workspace. Empty = prompt on first use.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="IndexOnStartup" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Refresh the local search index when the app starts.</desc>
        </info>
        <value>true</value>
      </prop>
    </group>
    <group oor:name="Sync">
      <info>
        <desc>Optional sync (see docs/sync.md). Off unless a provider is set.</desc>
      </info>
      <prop oor:name="Provider" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>none | folder | webdav | novaserver | plugin id</desc>
        </info>
        <value>none</value>
      </prop>
      <prop oor:name="ServerUrl" oor:type="xs:string" oor:nillable="true">
        <info>
          <desc>Base URL when Provider = novaserver.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="OfflineMasterSwitch" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Block ALL outbound network for the app (see docs/privacy.md).</desc>
        </info>
        <value>false</value>
      </prop>
    </group>
    <group oor:name="AI">
      <info>
        <desc>Optional AI (TRD Sec 20). Disabled by default.</desc>
      </info>
      <prop oor:name="Provider" oor:type="xs:string" oor:nillable="false">
        <info>
          <desc>disabled | local | openai-compatible | ollama | plugin id</desc>
        </info>
        <value>disabled</value>
      </prop>
      <prop oor:name="Endpoint" oor:type="xs:string" oor:nillable="true">
        <info>
          <desc>Base URL for openai-compatible / ollama providers.</desc>
        </info>
        <value/>
      </prop>
      <prop oor:name="SendDocumentContent" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Allow AI features to send document text to a remote provider. Explicit opt-in (docs/privacy.md).</desc>
        </info>
        <value>false</value>
      </prop>
    </group>
    <group oor:name="Telemetry">
      <info>
        <desc>TRD Sec 19 — off unless explicitly opted in.</desc>
      </info>
      <prop oor:name="Enabled" oor:type="xs:boolean" oor:nillable="false">
        <info>
          <desc>Send anonymous usage telemetry.</desc>
        </info>
        <value>false</value>
      </prop>
    </group>
  </component>
</oor:component-schema>
