# Patch: 0002-officecfg-add-nova-schema.patch
# Why:   LibreOffice has one primary configuration ("registry", built by
#        officecfg). This adds the additive Nova settings tree
#        (org.openoffice.Nova — Appearance/Workspace/Sync/AI/Telemetry) to it so
#        nova_theme / nova_shell can read it via configmgr. The Nova.xcs/.xcu
#        files are copied into officecfg/registry/ by scripts/nova-autogen.sh
#        from their canonical home in nova/nova_config/registry/.
#        Product NAME / VENDOR are NOT here — those are ./configure flags
#        (--with-product-name / --with-vendor), injected by nova-autogen.sh.
# Scope: officecfg/files.mk, officecfg/Configuration_officecfg.mk (+2 lines);
#        officecfg/registry/{schema,data}/org/openoffice/Nova.{xcs,xcu} (new,
#        also delivered by nova-autogen.sh so the patch body is informational).
# Upstreaming: N/A — Nova-specific configuration.
# Rebase risk: low.
#
diff --git a/officecfg/Configuration_officecfg.mk b/officecfg/Configuration_officecfg.mk
index 01702a06b..9bfeb352d 100644
--- a/officecfg/Configuration_officecfg.mk
+++ b/officecfg/Configuration_officecfg.mk
@@ -28,6 +28,7 @@ $(eval $(call gb_Configuration_add_datas,registry,officecfg/registry/data,\
 	org/openoffice/Inet.xcu \
 	org/openoffice/System.xcu \
 	org/openoffice/UserProfile.xcu \
+	org/openoffice/Nova.xcu \
 	org/openoffice/VCL.xcu \
 	org/openoffice/Interaction.xcu \
 	org/openoffice/Office/Calc.xcu \
diff --git a/officecfg/files.mk b/officecfg/files.mk
index cd5843e2d..f027c2d0f 100644
--- a/officecfg/files.mk
+++ b/officecfg/files.mk
@@ -97,6 +97,7 @@ officecfg_XCSFILES := \
     Office/Views \
     Office/Writer \
     Office/WriterWeb \
+    Nova \
     Setup \
     System \
     TypeDetection/Filter \
diff --git a/officecfg/registry/data/org/openoffice/Nova.xcu b/officecfg/registry/data/org/openoffice/Nova.xcu
new file mode 100644
index 000000000..5624d29db
--- /dev/null
+++ b/officecfg/registry/data/org/openoffice/Nova.xcu
@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- SPDX-License-Identifier: MPL-2.0 -->
+<!-- Nova-Office default settings (override the schema defaults where wanted).
+     User changes land in the user profile's registrymodifications.xcu, never here. -->
+<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
+                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
+                    oor:name="Nova" oor:package="org.openoffice">
+  <node oor:name="Appearance">
+    <prop oor:name="Theme"><value>system</value></prop>
+    <prop oor:name="NovaUiMode"><value>false</value></prop>
+  </node>
+  <node oor:name="Workspace">
+    <prop oor:name="IndexOnStartup"><value>true</value></prop>
+  </node>
+  <node oor:name="Sync">
+    <prop oor:name="Provider"><value>none</value></prop>
+  </node>
+  <node oor:name="AI">
+    <prop oor:name="Provider"><value>disabled</value></prop>
+    <prop oor:name="SendDocumentContent"><value>false</value></prop>
+  </node>
+  <node oor:name="Telemetry">
+    <prop oor:name="Enabled"><value>false</value></prop>
+  </node>
+</oor:component-data>
diff --git a/officecfg/registry/schema/org/openoffice/Nova.xcs b/officecfg/registry/schema/org/openoffice/Nova.xcs
new file mode 100644
index 000000000..a32ee315c
--- /dev/null
+++ b/officecfg/registry/schema/org/openoffice/Nova.xcs
@@ -0,0 +1,86 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- SPDX-License-Identifier: MPL-2.0 -->
+<!-- Nova-Office configuration schema. Additive: does not touch any upstream
+     officecfg node. Nova code reads/writes these via the configmgr
+     (com.sun.star.configuration.ConfigurationProvider), same as all LO settings.
+     Branding values come from a *separate* generated overlay
+     (product/generated/Nova-Branding.xcu) — see docs/rebranding.md. -->
+<oor:component-schema xmlns:oor="http://openoffice.org/2001/registry"
+                      xmlns:xs="http://www.w3.org/2001/XMLSchema"
+                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+                      oor:name="Nova" oor:package="org.openoffice" xml:lang="en-US">
+  <templates/>
+  <component>
+
+    <group oor:name="Appearance">
+      <info><desc>Theme + visual mode (docs/design-system.md §7).</desc></info>
+      <prop oor:name="Theme" oor:type="xs:string" oor:nillable="false">
+        <info><desc>light | dark | system | hc</desc></info>
+        <value>system</value>
+      </prop>
+      <prop oor:name="ReducedMotion" oor:type="xs:boolean" oor:nillable="false">
+        <info><desc>Collapse animations (also follows the OS setting).</desc></info>
+        <value>false</value>
+      </prop>
+      <prop oor:name="NovaUiMode" oor:type="xs:boolean" oor:nillable="false">
+        <info><desc>Use the Nova shell (contextual toolbar, sidebar, palette)
+          instead of the classic LibreOffice UI. EXPERIMENTAL until nova_shell lands.</desc></info>
+        <value>false</value>
+      </prop>
+    </group>
+
+    <group oor:name="Workspace">
+      <info><desc>Local workspace (docs/architecture.md §5).</desc></info>
+      <prop oor:name="DefaultPath" oor:type="xs:string" oor:nillable="true">
+        <info><desc>Filesystem path of the active workspace. Empty = prompt on first use.</desc></info>
+        <value></value>
+      </prop>
+      <prop oor:name="IndexOnStartup" oor:type="xs:boolean" oor:nillable="false">
+        <info><desc>Refresh the local search index (FTS5) when the app starts.</desc></info>
+        <value>true</value>
+      </prop>
+    </group>
+
+    <group oor:name="Sync">
+      <info><desc>Optional sync (docs/sync.md). Off unless a provider is set.</desc></info>
+      <prop oor:name="Provider" oor:type="xs:string" oor:nillable="false">
+        <info><desc>none | folder | webdav | novaserver | &lt;plugin id&gt;</desc></info>
+        <value>none</value>
+      </prop>
+      <prop oor:name="ServerUrl" oor:type="xs:string" oor:nillable="true">
+        <info><desc>Base URL when Provider = novaserver. Empty = use the product default (may also be empty).</desc></info>
+        <value></value>
+      </prop>
+      <prop oor:name="OfflineMasterSwitch" oor:type="xs:boolean" oor:nillable="false">
+        <info><desc>Block ALL outbound network for the app (docs/privacy.md §4).</desc></info>
+        <value>false</value>
+      </prop>
+    </group>
+
+    <group oor:name="AI">
+      <info><desc>Optional AI (TRD §20). Disabled by default.</desc></info>
+      <prop oor:name="Provider" oor:type="xs:string" oor:nillable="false">
+        <info><desc>disabled | local | openai-compatible | ollama | &lt;plugin id&gt;</desc></info>
+        <value>disabled</value>
+      </prop>
+      <prop oor:name="Endpoint" oor:type="xs:string" oor:nillable="true">
+        <info><desc>Base URL for openai-compatible / ollama providers.</desc></info>
+        <value></value>
+      </prop>
+      <prop oor:name="SendDocumentContent" oor:type="xs:boolean" oor:nillable="false">
+        <info><desc>Allow AI features to send document text to a remote provider.
+          Must be explicitly enabled (docs/privacy.md §1).</desc></info>
+        <value>false</value>
+      </prop>
+    </group>
+
+    <group oor:name="Telemetry">
+      <info><desc>TRD §19 — off unless explicitly opted in. The generated
+        Nova-Branding overlay may leave the endpoint empty, which also disables it.</desc></info>
+      <prop oor:name="Enabled" oor:type="xs:boolean" oor:nillable="false">
+        <value>false</value>
+      </prop>
+    </group>
+
+  </component>
+</oor:component-schema>
