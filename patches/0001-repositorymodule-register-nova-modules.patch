# Patch: 0001-repositorymodule-register-nova-modules.patch
# Why:   RepositoryModule_host.mk is a build-graph root and cannot live outside
#        the tree; this registers the nova_* gbuild modules so `make` sees them.
#        The one expected standing patch (ADR-0001). Add each new nova_* module
#        to this list as it is built.
# Scope: RepositoryModule_host.mk  (+1 line so far: nova_config)
# Upstreaming: N/A — fork-specific module registration.
# Rebase risk: low (append in an alphabetical list).
#
diff --git a/RepositoryModule_host.mk b/RepositoryModule_host.mk
index 0da023325..366b85293 100644
--- a/RepositoryModule_host.mk
+++ b/RepositoryModule_host.mk
@@ -109,6 +109,7 @@ $(eval $(call gb_Module_add_moduledirs,libreoffice,\
 	$(call gb_Helper_optional,DESKTOP,l10ntools) \
 	net_ure \
 	$(call gb_Helper_optional,NLPSOLVER,nlpsolver) \
+	nova_config \
 	o3tl \
 	$(call gb_Helper_optional,ODK,odk) \
 	offapi \
