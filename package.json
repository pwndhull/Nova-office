{
  "name": "nova-office",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Office — a modern office suite built on LibreOffice's document engine.",
  "license": "MPL-2.0",
  "workspaces": [
    "ui/tokens",
    "ui/motion",
    "ui/icons",
    "ui/components",
    "ui/playground",
    "tests"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:tokens": "node ui/tokens/build.mjs",
    "build": "npm run build:tokens && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "playground": "npm run dev --workspace @nova/playground",
    "version:bump": "node scripts/version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
